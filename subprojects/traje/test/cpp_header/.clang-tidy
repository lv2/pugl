Checks: >
  *,
  -*-avoid-c-arrays,
  -llvmlibc-*,
  -modernize-use-trailing-return-type,
CheckOptions:
  - key:   readability-function-cognitive-complexity.Threshold
    value: '0'
FormatStyle: file
HeaderFilterRegex: 'traje/[^/]*\.hpp'
